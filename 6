const double PI = acos(-1);

string to_comma(double value) {
    stringstream ss;
    ss << fixed << setprecision(6) << value;
    string s = ss.str();
    size_t pos = s.find('.');
    if (pos != string::npos) {
        s[pos] = ',';
    }
    return s;
}

double f(double x) {
    if (x >= 0 && x < 2) {
        return (10.0 * x) / 2;
    }
    else if (x >= 2 && x < 20) {
        return 10.0 * (x - 20) / (2 - 20);
    }
    return 0.0;
}

void z1() {
    cout << "ЗАДАНИЕ 1\n";

    double w = 20.0;
    double h = 10.0;
    double Srect = w * h;
    int N = 10000;
    int M = 0;

    ofstream file("C:\\Users\\User\\OneDrive\\Desktop\\6\\task1.csv");
    file << "Тип;x;y;\n";

    for (double x = 0; x <= 20; x += 0.1) {
        file << "graph;" << to_comma(x) << ";" << to_comma(f(x)) << "\n";
    }

    file << ";;\n";

    for (int i = 0; i < N; i++) {
        double x = (double)rand() / RAND_MAX * w;
        double y = (double)rand() / RAND_MAX * h;

        int inside = (y < f(x)) ? 1 : 0;
        if (inside) M++;

        if (i % 50 == 0) {
            file << "point;" << to_comma(x) << ";" << to_comma(y) << "\n";
        }
    }

    file.close();

    double S = (double)M / N * Srect;
    double Stoch = 100.0;

    cout << "Точек N = " << N << endl;
    cout << "Попало M = " << M << endl;
    cout << "Площадь = " << S << endl;
    cout << "Точная площадь = " << Stoch << endl;
    cout << "Погрешность = " << fabs(S - Stoch) << endl;
}

void z2() {
    cout << "\nЗАДАНИЕ 2\n";

    auto g = [](double x) {
        return sqrt(11.0 - 2.0 * sin(x) * sin(x));
        };

    double a = 0.0;
    double b = 5.0;
    double maxY = 0.0;
    for (double x = a; x <= b; x += 0.001) {
        double val = g(x);
        if (val > maxY) maxY = val;
    }
    maxY += 0.5;

    int N = 10000;
    int M = 0;

    ofstream file("C:\\Users\\User\\OneDrive\\Desktop\\6\\task2.csv");
    file << "Тип;x;y\n";

    for (double x = 0; x <= 5; x += 0.05) {
        file << "graph;" << to_comma(x) << ";" << to_comma(g(x)) << "\n";
    }

    file << ";;\n";

    for (int i = 0; i < N; i++) {
        double x = a + (double)rand() / RAND_MAX * (b - a);
        double y = (double)rand() / RAND_MAX * maxY;

        int inside = (y <= g(x)) ? 1 : 0;
        if (inside) M++;

        if (i % 50 == 0) {
            file << "point;" << to_comma(x) << ";" << to_comma(y) << "\n";
        }
    }

    file.close();

    double I = (double)M / N * (b - a) * maxY;

    cout << "Интеграл = " << I << endl;
    cout << "Точек N = " << N << endl;
    cout << "Попало M = " << M << endl;
    cout << "Высота = " << maxY << endl;
}

void z3() {
    cout << "\nЗАДАНИЕ 3\n";

    double R = 2.0;
    int N = 10000;
    int M = 0;

    ofstream file("C:\\Users\\User\\OneDrive\\Desktop\\6\\task3.csv");
    file << "Тип;x;y\n";

    for (double phi = 0; phi <= 2 * PI; phi += 0.05) {
        double x = R * cos(phi);
        double y = R * sin(phi);
        file << "circle;" << to_comma(x) << ";" << to_comma(y) << "\n";
    }

    file << "square;" << to_comma(-R) << ";" << to_comma(-R) << ";\n";
    file << "square;" << to_comma(R) << ";" << to_comma(-R) << ";\n";
    file << "square;" << to_comma(R) << ";" << to_comma(R) << ";\n";
    file << "square;" << to_comma(-R) << ";" << to_comma(R) << ";\n";
    file << "square;" << to_comma(-R) << ";" << to_comma(-R) << ";\n";

    file << ";;\n";

    for (int i = 0; i < N; i++) {
        double x = -R + (double)rand() / RAND_MAX * (2 * R);
        double y = -R + (double)rand() / RAND_MAX * (2 * R);

        int inside = (x * x + y * y <= R * R) ? 1 : 0;
        if (inside) M++;

        if (i % 50 == 0) {
            file << "point;" << to_comma(x) << ";" << to_comma(y) << "\n";
        }
    }

    file.close();

    double pi_approx = 4.0 * M / N;

    cout << "Радиус R = " << R << endl;
    cout << "Точек N = " << N << endl;
    cout << "Попало M = " << M << endl;
    cout << "pi = " << pi_approx << endl;
    cout << "Точное pi = " << PI << endl;
    cout << "Погрешность = " << fabs(pi_approx - PI) << endl;
}

void z4() {
    cout << "\nЗАДАНИЕ 4\n";

    double A = 13.0;
    double B = 9.0;
    double Rmax = sqrt(max(A, B));
    int N = 10000;
    int M = 0;

    ofstream file("C:\\Users\\User\\OneDrive\\Desktop\\6\\task4.csv");
    file << "Тип;x;y\n";

    for (double phi = 0; phi <= 2 * PI; phi += 0.05) {
        double r = sqrt(A * cos(phi) * cos(phi) + B * sin(phi) * sin(phi));
        double x = r * cos(phi);
        double y = r * sin(phi);
        file << "boundary;" << to_comma(x) << ";" << to_comma(y) << "\n";
    }

    file << ";;\n";

    for (int i = 0; i < N; i++) {
        double x = -Rmax + (double)rand() / RAND_MAX * (2 * Rmax);
        double y = -Rmax + (double)rand() / RAND_MAX * (2 * Rmax);
        double r = sqrt(x * x + y * y);
        double phi = atan2(y, x);
        if (phi < 0) phi += 2 * PI;
        double r_max = sqrt(A * cos(phi) * cos(phi) + B * sin(phi) * sin(phi));

        int inside = (r <= r_max) ? 1 : 0;
        if (inside) M++;

        if (i % 50 == 0) {
            file << "point;" << to_comma(x) << ";" << to_comma(y) << "\n";
        }
    }

    file.close();

    double Ssquare = (2 * Rmax) * (2 * Rmax);
    double Sfig = (double)M / N * Ssquare;

    cout << "Точек N = " << N << endl;
    cout << "Попало M = " << M << endl;
    cout << "Площадь = " << Sfig << endl;
}

