#include <iostream>
#include <cmath>
#include <iomanip>
#include <vector>
using namespace std;

const double pi = acos(-1);

double erf_integrand(double t) {
    return exp(-t * t);
}

double simpson_erf(double x, int n) {
    if (x == 0.0) return 0.0;
    double h = x / n;
    double sum = erf_integrand(0) + erf_integrand(x);
    for (int i = 1; i < n; i++) {
        double t = i * h;
        if (i % 2 == 0) sum += 2 * erf_integrand(t);
        else sum += 4 * erf_integrand(t);
    }
    return (h / 3.0) * sum;
}

double erf_custom(double x) {
    if (x < 0) return -erf_custom(-x);
    const double sqrt_pi = sqrt(pi);
    double integral = simpson_erf(x, 1000);
    return (2.0 / sqrt_pi) * integral;
}

